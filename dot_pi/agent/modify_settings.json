#!/bin/bash
# Merge chezmoi-managed keys into existing pi settings.
# Existing keys not listed here are preserved.

if ! command -v jq &>/dev/null; then
  echo "jq is required but not installed" >&2
  cat  # pass through unchanged
  exit 0
fi

MANAGED='{
  "compaction": {
    "enabled": true
  }
}'

# Remove paths that Pi discovers automatically or that no longer exist.
OBSOLETE_PATHS='[
  "~/.pi/agent/skills",
  "~/.pi/agent/prompts",
  "~/.pi/agent/extensions",
  "~/.claude/skills",
  "~/.claude/commands"
]'

# Read current file from stdin; if empty, start with {}
CURRENT=$(cat)
if [ -z "$CURRENT" ]; then
  CURRENT="{}"
fi

# Deep merge: managed keys win; array values are unioned and deduplicated.
echo "$CURRENT" | jq --argjson managed "$MANAGED" --argjson obsolete "$OBSOLETE_PATHS" '
  . as $current | . * $managed
  | reduce ("skills", "prompts", "extensions") as $k (.;
      (
        [($current[$k] // [])[], ($managed[$k] // [])[]]
        | map(select(. as $entry | $obsolete | index($entry) | not))
        | unique
      ) as $values
      | if ($values | length) > 0 then .[$k] = $values else del(.[$k]) end
    )
'
