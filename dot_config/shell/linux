# Open a file or URL with its default application.
open() {
  xdg-open "$@" >/dev/null 2>&1
}

# Find Arch packages without leaving the terminal.
yayf() {
  command -v yay >/dev/null 2>&1 || {
    echo "yayf requires yay" >&2
    return 127
  }
  command -v fzf >/dev/null 2>&1 || {
    echo "yayf requires fzf" >&2
    return 127
  }

  yay -Slq | fzf --multi --preview 'yay -Sii {1}' --preview-window=down:75% | xargs -r yay -S
}

# Create a desktop launcher for a Chromium web app.
web2app() {
  if [ "$#" -ne 3 ]; then
    echo "Usage: web2app <AppName> <AppURL> <IconURL>" >&2
    return 1
  fi

  local app_name="$1"
  local app_url="$2"
  local icon_url="$3"
  local icon_dir="$HOME/.local/share/applications/icons"
  local desktop_file="$HOME/.local/share/applications/${app_name}.desktop"
  local icon_path="${icon_dir}/${app_name}.png"

  mkdir -p "$icon_dir"

  if ! curl --fail --silent --show-error --location --output "$icon_path" "$icon_url"; then
    echo "Error: failed to download icon" >&2
    return 1
  fi

  cat >"$desktop_file" <<EOF
[Desktop Entry]
Version=1.0
Name=$app_name
Comment=$app_name
Exec=chromium --new-window --ozone-platform=wayland --app="$app_url" --name="$app_name" --class="$app_name"
Terminal=false
Type=Application
Icon=$icon_path
StartupNotify=true
EOF

  chmod +x "$desktop_file"
}

web2app-remove() {
  if [ "$#" -ne 1 ]; then
    echo "Usage: web2app-remove <AppName>" >&2
    return 1
  fi

  rm -f \
    "$HOME/.local/share/applications/${1}.desktop" \
    "$HOME/.local/share/applications/icons/${1}.png"
}

# Make external Apple keyboards use F1-F12 by default.
fix_fkeys() {
  echo 2 | sudo tee /sys/module/hid_apple/parameters/fnmode
}
