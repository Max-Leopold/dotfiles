# Shared configuration
source "$HOME/.config/bash/shell"
source "$HOME/.config/shell/envs"
source "$HOME/.config/shell/aliases"
source "$HOME/.config/shell/functions"

[[ "$OSTYPE" == linux* && -r "$HOME/.config/shell/linux" ]] && source "$HOME/.config/shell/linux"

# Bash-specific configuration
source "$HOME/.config/bash/init"
source "$HOME/.config/bash/prompt"

[[ -r "$HOME/.config/bash/local" ]] && source "$HOME/.config/bash/local"
