# Shared configuration
source "$HOME/.config/zsh/shell"
source "$HOME/.config/shell/envs"
source "$HOME/.config/shell/aliases"
source "$HOME/.config/shell/functions"

[[ "$OSTYPE" == linux* && -r "$HOME/.config/shell/linux" ]] && source "$HOME/.config/shell/linux"

# Zsh-specific configuration
source "$HOME/.config/zsh/init"
source "$HOME/.config/zsh/prompt"

[[ -r "$HOME/.config/zsh/local" ]] && source "$HOME/.config/zsh/local"
