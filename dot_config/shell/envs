# Editor used by CLI
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"

path_prepend() {
  [ -d "$1" ] || return 0

  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

path_prepend "$HOME/.local/bin"

if [ -d "$HOME/.bun" ]; then
  export BUN_INSTALL="$HOME/.bun"
  path_prepend "$BUN_INSTALL/bin"
fi

if [ "$(uname -s)" = "Linux" ]; then
  path_prepend "$HOME/.local/share/omarchy/bin"
fi

if [ -n "${BASH_VERSION:-}" ]; then
  path_dedupe() {
    local old_ifs="$IFS"
    local path_entry
    local deduped_path=""

    IFS=:
    for path_entry in $PATH; do
      [ -n "$path_entry" ] || continue
      case ":$deduped_path:" in
        *":$path_entry:"*) ;;
        *) deduped_path="${deduped_path:+$deduped_path:}$path_entry" ;;
      esac
    done
    IFS="$old_ifs"
    PATH="$deduped_path"
  }

  path_dedupe
  unset -f path_dedupe
fi

export PATH
unset -f path_prepend
